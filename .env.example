VITE_APP_ENV=development
VITE_AGENT_API_BASE_URL=http://localhost:8787

# 수익화 (전부 선택 — 값이 있는 것만 후원 모달에 노출)
# Buy Me a Coffee — https://www.buymeacoffee.com 가입 후 username
VITE_BMC_USERNAME=
# Stripe Payment Link — https://dashboard.stripe.com/payment-links 에서 생성한 URL
VITE_STRIPE_PAYMENT_URL=
# Toss 송금하기 (toss.me/<username>) — https://toss.me 가입 후 username
VITE_TOSS_USERNAME=
# 카카오페이 송금하기 URL — 카카오톡 송금 페이지 링크
VITE_KAKAOPAY_URL=
# 계좌이체 안내 텍스트 (자유 형식, 예: "토스뱅크 / 홍길동 / 1000-1234-5678")
VITE_BANK_ACCOUNT=
# Google AdSense — Publisher ID (ca-pub-XXXXXXXX)
VITE_ADSENSE_CLIENT_ID=
